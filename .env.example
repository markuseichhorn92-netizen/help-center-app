# FIT INN Help Center – Beispiel-Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
# NIEMALS echte Secrets committen – Produktionswerte werden als Vercel-Env gesetzt.

# --- Admin-Zugang ---
ADMIN_USER=
ADMIN_PASS=

# --- Vercel KV (Redis) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- E-Mail (Resend, ausgehend) ---
RESEND_API_KEY=
SUPPORT_EMAIL=

# --- E-Mail (IMAP/IONOS, eingehend) ---
IMAP_HOST=
IMAP_USER=
IMAP_PASS=

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- AI (Anthropic Claude) ---
ANTHROPIC_API_KEY=

# --- Basis-URL für Webhook-Callbacks ---
NEXT_PUBLIC_BASE_URL=https://hilfe.fit-inn-trier.de

# --- Cron-Jobs ---
CRON_SECRET=

# --- Web Push (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Magicline Webhooks ---
# Schlüssel, mit dem eingehende Magicline-Webhooks über den x-api-key Header authentifiziert werden.
MAGICLINE_WEBHOOK_KEY=
# Schlüssel für die Weiterleitung von CONTRACT_CREATED-Events an die Fit-Inn Mitglieder-App
# (https://mitglieder.fit-inn-trier.de), die daraufhin die Zugangs-/Willkommensmail verschickt.
FITINN_WEBHOOK_KEY=

# --- TV-Dashboard (separate KV-Verbindung) ---
DASHBOARD_KV_KV_REST_API_URL=
DASHBOARD_KV_KV_REST_API_TOKEN=
